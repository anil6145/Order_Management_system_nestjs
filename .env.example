# Application
PORT=3000

# Database Configuration (Pointed to PgBouncer pooler by default)
DB_HOST=localhost
DB_PORT=6432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=order_management_system_advanced

# Database Connection Pool Settings (TypeORM / pg driver pool)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# PgBouncer Docker Configuration
PGBOUNCER_HOST_PORT=6432
PGBOUNCER_POOL_SIZE=20

# JWT Authentication
# Generate strong 64-character random hex strings in production
JWT_ACCESS_SECRET=your_jwt_access_secret_hex_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# System / Background Jobs
# Valid UUID of a dedicated system user (required for OrderCleanupService stock restoration)
AUTO_CANCEL_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000

# Redis & BullMQ Queue Configuration (Used by AuditModule)
REDIS_HOST=localhost
REDIS_PORT=6379
